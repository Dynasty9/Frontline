extends Node
func _ready() -> void:
	TestRun.watch()
	var panel := HudMoments.new()
	panel.push("gain", "Enemy Humvee destroyed", Vector3.ZERO)
	panel.push("gain", "Enemy Technical destroyed", Vector3.ONE)
	panel.tick(2.0)
	panel.push("gain", "Enemy Humvee destroyed", Vector3(20, 0, 0))
	assert(panel.items.size() == 2)
	assert(panel.items[0][1] == "Enemy Humvee destroyed")
	assert(panel.items[0][2] == Vector3(20, 0, 0))
	assert(panel.items[0][3] == 0.0)
	assert(panel.items[0][4] == 2)
	panel.push("loss", "Enemy Humvee destroyed", Vector3.ONE)
	assert(panel.items[0][0] == "loss" and panel.items[0][4] == 1)
	panel.tick(HudMoments.LIFE + 0.1)
	assert(panel.items.is_empty() and not panel.visible)
	panel.free()
	print("MOMENT ORDER failures=0")
	TestRun.quit(get_tree())
