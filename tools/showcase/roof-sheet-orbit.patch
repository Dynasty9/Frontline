+## Matched decorative-surface review: move only the studio camera, keeping
+## production meshes/materials and daylight fixed. Encode the 60 frames at 15 fps.
+func _capture_orbit(grid: GridContainer, kind: String) -> void:
+	var camera := grid.find_children("*", "Camera3D", true, false)[0] as Camera3D
+	var label := grid.find_children("*", "Label", true, false)[0] as Label
+	label.text = orbit_label
+	label.add_theme_font_size_override("font_size", 30)
+	label.add_theme_color_override("font_shadow_color", Color.BLACK)
+	label.add_theme_constant_override("shadow_offset_x", 2)
+	label.add_theme_constant_override("shadow_offset_y", 2)
+	var m: Array = cameras[kind]
+	var center := Vector3(float(m[0]), float(m[1]), float(m[2]))
+	var eye := camera.position - center
+	var count := 3 if orbit_sample else 60
+	for i in count:
+		var angle := lerpf(-0.18, 0.18, float(i) / float(count - 1))
+		camera.position = center + eye.rotated(Vector3.UP, angle)
+		camera.look_at(center)
+		for warmup in (24 if i == 0 else 1):
+			await get_tree().process_frame
+		await RenderingServer.frame_post_draw
+		get_viewport().get_texture().get_image().save_png(output.path_join("orbit-%04d.png" % i))
+	print("SURFACE_ORBIT frames=%d renderer=%s drawn=%d" % [count, RenderingServer.get_current_rendering_method(), Engine.get_frames_drawn()])
