; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

run/flush_stdout_on_print=true

config/name="Frontline"
config/description="Squad-based multiplayer RTS with thinking soldiers."
config/version="0.0.0-dev"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.031, 0.039, 0.043, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Errors="*res://scripts/autoload/errors.gd"
Links="*res://scripts/autoload/links.gd"
Defs="*res://scripts/autoload/defs.gd"
Net="*res://scripts/autoload/net.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Settings="*res://scripts/autoload/settings.gd"
Keys="*res://scripts/autoload/keys.gd"
Music="*res://scripts/autoload/music.gd"
Online="*res://scripts/autoload/online.gd"
Updater="*res://scripts/autoload/updater.gd"
LocalServer="*res://scripts/autoload/local_server.gd"

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=6
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/world_boundary_shape_size=8192.0

[rendering]

limits/global_shader_variables/buffer_size=2097152
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
shading/overrides/force_vertex_shading.web=true
textures/vram_compression/import_etc2_astc=true

[shader_globals]

water_time={
"type": "float",
"value": 0.0
}
