; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Frontline"
config/description="Squad-based multiplayer RTS with thinking soldiers."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Defs="*res://scripts/autoload/defs.gd"
Net="*res://scripts/autoload/net.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=6

[rendering]

limits/global_shader_variables/buffer_size=524288
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
